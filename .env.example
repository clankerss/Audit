# Wajib: API key dari https://console.anthropic.com
ANTHROPIC_API_KEY=

# Sangat disarankan: password untuk memakai Audit. Tanpa ini, siapa pun yang tahu URL server bisa memakai kredit API kamu.
ACCESS_KEY=

# Opsional: token GitHub (tanpa izin apa pun) supaya cek GitHub tidak cepat kena rate limit.
GITHUB_TOKEN=

# Opsional
AUDIT_MODEL=claude-sonnet-5-5
AUDIT_MAX_STEPS=24
MAX_CONCURRENT=2
PORT=3000
